#!/usr/bin/python3
# omarchy:summary=Print the OpenRouter usage record as JSON
# omarchy:hidden=true
"""Collect OpenRouter usage into one display-ready JSON record.

Token stats come from pi session transcripts under ~/.pi/agent/sessions
(and ~/.omp/agent/sessions), filtered to provider "openrouter" — every model
routed through OpenRouter (GLM, Kimi, …) lands in one record. The prepaid
balance comes from OpenRouter's own API: /credits for the account ledger,
falling back to the key's spending limit. The agents panel only ever reads
the JSON this prints.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "openrouter"
AGENT_NAME = "OpenRouter"
AUTH_HELP = "Set OPENROUTER_API_KEY or sign in to OpenRouter in opencode."
API_BASE_URL = "https://openrouter.ai/api/v1"


def number(value: Any) -> int:
  try:
    return max(0, round(float(value or 0)))
  except (TypeError, ValueError):
    return 0


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def local_date_from_timestamp(value: Any) -> str:
  if isinstance(value, (int, float)):
    seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
    try:
      return dt.datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")
    except Exception:
      pass
  raw = str(value or "").strip()
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return parsed.strftime("%Y-%m-%d")
  except Exception:
    return dt.datetime.now().strftime("%Y-%m-%d")


# ---------------------------------------------------------------- local scan


def scan_sessions(roots: list[Path]) -> dict[str, Any]:
  today = local_date_from_timestamp(None)
  recent_dates = [(dt.date.today() - dt.timedelta(days=o)).isoformat() for o in range(6, -1, -1)]
  recent = {day: 0 for day in recent_dates}
  sessions: set[str] = set()
  active_dates: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  seen: set[str] = set()
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  for root in roots:
    for path in root.rglob("*.jsonl"):
      try:
        handle = path.open("r", encoding="utf-8", errors="replace")
      except OSError:
        continue
      with handle:
        for line_number, line in enumerate(handle, 1):
          # pi writes compact JSON; both pre-filters keep unrelated lines cheap.
          if '"usage"' not in line or '"openrouter"' not in line:
            continue
          try:
            entry = json.loads(line)
            message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
            if entry.get("type") != "message" or message.get("role") != "assistant":
              continue
            if str(message.get("provider") or "") != "openrouter":
              continue
            # Session copies (nested run dirs) repeat message ids; the uuid
            # is the dedup key, falling back to file position when absent.
            unique_key = str(entry.get("id") or f"{path}:{line_number}")
            if unique_key in seen:
              continue
            seen.add(unique_key)
            usage = message.get("usage") or {}
            input_tokens = number(usage.get("input"))
            output_tokens = number(usage.get("output")) + number(usage.get("reasoning"))
            cache_read = number(usage.get("cacheRead"))
            cache_write = number(usage.get("cacheWrite"))
            total = input_tokens + output_tokens + cache_read + cache_write
            if total <= 0:
              total = number(usage.get("totalTokens"))
            if total <= 0:
              continue
            model = str(message.get("model") or "unknown").rstrip("/").split("/")[-1]
            day = local_date_from_timestamp(entry.get("timestamp"))
          except Exception:
            continue

          session_key = str(path)
          sessions.add(session_key)
          active_dates.add(day)
          prompts += 1
          bucket = usage_by_model.setdefault(model, empty_bucket())
          bucket["inputTokens"] += input_tokens
          bucket["outputTokens"] += output_tokens
          bucket["cacheReadInputTokens"] += cache_read
          bucket["cacheCreationInputTokens"] += cache_write
          if day in recent:
            recent[day] += total
          if day == today:
            today_prompt_count += 1
            today_sessions.add(session_key)
            today_token_total += total
            today_tokens[model] = today_tokens.get(model, 0) + total

  return {
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
  }


# ----------------------------------------------------------------- openrouter


def read_opencode_key() -> str:
  path = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "auth.json"
  try:
    parsed = json.loads(path.read_text())
  except (OSError, json.JSONDecodeError):
    return ""
  entry = parsed.get("openrouter") if isinstance(parsed, dict) else None
  return str(entry.get("key") or "").strip() if isinstance(entry, dict) else ""


def api_get(path: str, api_key: str) -> dict[str, Any] | None:
  request = urllib.request.Request(
    API_BASE_URL + path,
    headers={"Authorization": "Bearer " + api_key, "Accept": "application/json"},
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
    return payload.get("data") if isinstance(payload, dict) else None
  except Exception:
    return None


# Balance from the account credit ledger; a key-level spending limit is the
# fallback (remaining budget instead of prepaid credits, labeled estimated).
def collect_balance(api_key: str) -> tuple[dict[str, Any] | None, str, str]:
  credits = api_get("/credits", api_key)
  if isinstance(credits, dict) and number(credits.get("total_credits")) > 0:
    funded = float(credits.get("total_credits") or 0)
    spent = float(credits.get("total_usage") or 0)
    return {
      "remaining": max(0.0, funded - spent),
      "funded": funded,
      "spent": spent,
      "currency": "USD",
      "estimated": False,
    }, "Prepaid", ""

  key = api_get("/key", api_key)
  if isinstance(key, dict):
    if isinstance(key.get("limit"), (int, float)) and key.get("limit") > 0:
      limit = float(key["limit"])
      remaining = max(0.0, float(key.get("limit_remaining") or 0))
      return {
        "remaining": remaining,
        "funded": limit,
        "spent": max(0.0, limit - remaining),
        "currency": "USD",
        "estimated": True,
      }, "", ""
    if key.get("is_free_tier"):
      return None, "Free tier", ""
    return None, "", ""

  return None, "", "Couldn't reach OpenRouter's API. Retrying shortly. Local stats are still shown."


# -------------------------------------------------------------------- record


def record_path() -> Path:
  return Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")) / "omarchy" / "agents" / "usage" / f"{AGENT_ID}.json"


def write_record(record: dict[str, Any]) -> None:
  """Atomic write, skipping an unchanged record.

  The path unit that watches the usage directory fires on our own write, so
  an always-write would retrigger this collector forever. Comparing with the
  timestamp stripped breaks the loop; the extra run per real change is the
  cost. If nothing changed, the on-disk timestamp stays stale — it only ever
  means "no new data", not "collector stopped".
  """
  path = record_path()
  payload = json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n"
  try:
    existing = json.loads(path.read_text())
    existing.pop("updatedAt", None)
    changed = existing != {k: v for k, v in record.items() if k != "updatedAt"}
  except (OSError, json.JSONDecodeError):
    changed = True
  if not changed:
    return
  path.parent.mkdir(parents=True, exist_ok=True)
  tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
  tmp.write_text(payload)
  tmp.replace(path)


def main() -> int:
  roots = [
    Path.home() / ".pi" / "agent" / "sessions",
    Path.home() / ".omp" / "agent" / "sessions",
  ]
  stats = scan_sessions([r for r in roots if r.is_dir()])

  api_key = os.environ.get("OPENROUTER_API_KEY", "").strip() or read_opencode_key()
  balance, tier, help_text = (None, "", AUTH_HELP)
  if api_key:
    balance, tier, help_text = collect_balance(api_key)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0 or balance is not None,
    "hasLocalStats": True,
    "hasPromptStats": True,
    "tierLabel": tier,
    "usageStatusText": "" if api_key else "Waiting for auth",
    "authHelpText": help_text,
    "limits": [],
  }
  if balance:
    record["balance"] = balance
  record.update(stats)
  write_record(record)
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
