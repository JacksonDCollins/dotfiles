#!/usr/bin/env bash

# determine if the tmux server is running
if tmux list-sessions &>/dev/null; then
        TMUX_RUNNING=0
else
        TMUX_RUNNING=1
fi

# determine the user's current position relative tmux:
# serverless - there is no running tmux server
# attached   - the user is currently attached to the running tmux server
# detached   - the user is currently not attached to the running tmux server
T_RUNTYPE="serverless"
if [ "$TMUX_RUNNING" -eq 0 ]; then
        if [ "$TMUX" ]; then # inside tmux
                T_RUNTYPE="attached"
        else # outside tmux
                T_RUNTYPE="detached"
        fi
fi

# display help text with an argument
if [ "$1" = "-h" ] || [ "$1" == "--help" ]; then
        printf "\n"
        printf "\033[1m  t - the smart tmux session manager\033[0m\n"
        printf "\033[37m  https://github.com/joshmedeski/t-smart-tmux-session-manager\n"
        printf "\n"
        printf "\033[32m  Run interactive mode\n"
        printf "\033[34m      t\n"
        printf "\033[34m        ctrl-s list only tmux sessions\n"
        printf "\033[34m        ctrl-x list only zoxide results\n"
        printf "\033[34m        ctrl-f list results from the find command\n"
        printf "\n"
        printf "\033[32m  Go to session (matches tmux session, zoxide result, or directory)\n"
        printf "\033[34m      t {name}\n"
        printf "\n"
        printf "\033[32m  Show help\n"
        printf "\033[34m      t -h\n"
        printf "\033[34m      t --help\n"
        printf "\n"
        exit 0
fi

HOME_REPLACER=""                                          # default to a noop
echo "$HOME" | grep -E "^[a-zA-Z0-9\-_/.@]+$" &>/dev/null # chars safe to use in sed
HOME_SED_SAFE=$?
if [ $HOME_SED_SAFE -eq 0 ]; then # $HOME should be safe to use in sed
        HOME_REPLACER="s|^$HOME/|~/|"
fi

get_fzf_prompt() {
        local fzf_prompt
        local fzf_default_prompt='>  '
        if [ "$TMUX_RUNNING" -eq 0 ]; then
                fzf_prompt="$(tmux show -gqv '@t-fzf-prompt')"
        fi
        [ -n "$fzf_prompt" ] && echo "$fzf_prompt" || echo "$fzf_default_prompt"
}
PROMPT=$(get_fzf_prompt)

get_fzf_find_binding() {
        local fzf_find_binding
        local fzf_find_binding_default='ctrl-f:change-prompt(find> )+reload(find ~ -maxdepth 3 -type d)'
        if [ "$TMUX_RUNNING" -eq 0 ]; then
                fzf_find_binding="$(tmux show -gqv '@t-fzf-find-binding')"
        fi
        [ -n "$fzf_find_binding" ] && echo "$fzf_find_binding" || echo "$fzf_find_binding_default"
}

FIND_BIND=$(get_fzf_find_binding)

switch_idx_cmd_maker() {
        echo '
	CURRENT_SESSION_NAME={}; \
	CURRENT_IDX="$(tmux list-sessions -F "#{SESSIONIZER_IDX}" -f "#{?#{==:#{session_name},$CURRENT_SESSION_NAME},1,0}")"; \
			CURRENT_SESSION_ID="$(tmux list-sessions -F "#{session_id}" -f "#{?#{==:#{SESSIONIZER_IDX},$CURRENT_IDX},1,0}")"; \
			NEXT_IDX=$(($CURRENT_IDX + '"$1"')); \
			if [ "$NEXT_IDX" -gt 9 ]; then \
				NEXT_IDX=9; \
			elif [ "$NEXT_IDX" -lt 1 ]; then \
				NEXT_IDX=1; \
			fi; \
			NEXT_SESSION_ID="$(tmux list-sessions -F "#{session_id}" -f "#{?#{==:#{SESSIONIZER_IDX},$NEXT_IDX},1,0}")"; \
			tmux setenv -t "$NEXT_SESSION_ID" SESSIONIZER_IDX $CURRENT_IDX; \
			tmux setenv -t "$CURRENT_SESSION_ID" SESSIONIZER_IDX $NEXT_IDX;
			'
}
get_sessions_by_mru_with_idx_cmd="tmux list-sessions -F '#{SESSIONIZER_IDX} #{session_name}' -f '#{?#{>:#{SESSIONIZER_IDX},0},#{?#{<=:#{SESSIONIZER_IDX},9},1,0},0}' \
	| sort --numeric-sort | awk '{print \$2}' | head -n 9"
get_sessions_by_mru_with_idx() {
        eval "$get_sessions_by_mru_with_idx_cmd"
}
get_current_session_id() {
        if [ "$T_RUNTYPE" == "attached" ]; then
                tmux display-message -p "#{session_id}"
        else
                echo ""
        fi
}
get_sessions_by_mru_cmd="tmux list-sessions -f '#{!=:#{session_id},$(get_current_session_id)}' -F '#{session_last_attached} #{session_name}' | sort --numeric-sort --reverse | awk '{print \$2}; END {print \"———\"}'"

get_zoxide_results_cmd="zoxide query -l | sed -e \"$HOME_REPLACER\""

get_fzf_results_cmd() {
        if [ "$TMUX_RUNNING" -eq 0 ]; then
                fzf_default_results="$(tmux show -gqv '@t-fzf-default-results')"
                case $fzf_default_results in
                sessions)
                        echo "$get_sessions_by_mru_cmd"
                        ;;
                zoxide)
                        echo "$get_zoxide_results_cmd"
                        ;;
                *)
                        echo "$get_sessions_by_mru_cmd && $get_zoxide_results_cmd" # default shows both
                        ;;
                esac
        else
                echo "$get_zoxide_results_cmd" # only show zoxide results when outside tmux
        fi
}

get_history_files() {
        local hfiles_path
        hfiles_path="$HOME/.local/share/tmux/resurrect/"
        local hfiles
        hfiles=$(ls "$hfiles_path" -A)

        local file_list
        file_list=$(echo "$hfiles" | while IFS="" read -r f; do
                [[ -f "$hfiles_path$f" ]] || continue
                [[ $f == *.txt ]] || continue
                echo "$f"
        done)

        echo "$file_list" | sort -r
}

history_manager() {
        case $T_RUNTYPE in
        attached)
                if [[ -z $FZF_TMUX_OPTS ]]; then
                        FZF_TMUX_OPTS="-p 80%,80%"
                fi
                T_RUNTYPE_CMD="fzf-tmux $FZF_TMUX_OPTS"
                ;;
        detached)
                T_RUNTYPE_CMD="fzf"
                ;;
        serverless)
                T_RUNTYPE_CMD="fzf"
                ;;
        esac
        local hfiles_path
        hfiles_path="$HOME/.local/share/tmux/resurrect/"
        local new_resurrect_file
        new_resurrect_file=$(
                get_history_files | $T_RUNTYPE_CMD \
                        --border-label " Select a tmux resurrect file to restore " \
                        --header " enter load   esc exit" \
                        --prompt "history> " \
                        --preview "cat $hfiles_path{}" \
                        --bind "shift-up:preview-up" \
                        --bind "shift-down:preview-down"
        )
        if [ "$new_resurrect_file" = "" ]; then
                exit 0
        fi

        local resurrect_restore_path_option
        resurrect_restore_path_option=$(tmux show-option -gvq "@resurrect-restore-script-path")
        if [ -n "$resurrect_restore_path_option" ]; then
                rm "$hfiles_path"last 2>/dev/null
                ln -s "$hfiles_path$new_resurrect_file" "$hfiles_path"last
                $resurrect_restore_path_option
        fi

}

MARKED_SESSION_HEADER=" ^j move down   ^k move up   ^r remove   ^o preview   esc exit"
MARKED_BORDER_LABEL=" Marked Sessions (1-9) "
MOVE_DOWN_BIND="ctrl-j:unbind(ctrl-j)+execute-silent($(switch_idx_cmd_maker -1))+reload-sync($get_sessions_by_mru_with_idx_cmd)+down+rebind(ctrl-j)"
MOVE_UP_BIND="ctrl-k:unbind(ctrl-k)+execute-silent($(switch_idx_cmd_maker 1))+reload-sync($get_sessions_by_mru_with_idx_cmd)+up+rebind(ctrl-k)"
REMOVE_BIND="ctrl-r:execute-silent(tmux setenv -t ""{}"" SESSIONIZER_IDX '')+reload-sync($get_sessions_by_mru_with_idx_cmd)"

RNG_SEED=$RANDOM
TMP_PANE_FILE="/tmp/pane-{}-$RNG_SEED"
GET_CURRNET_PANE_CMD="cat $TMP_PANE_FILE 2>/dev/null || echo 1"
GET_TOTAL_PANES_CMD="tmux list-panes -t {} | wc -l"
LABEL_CMD="echo Session: {}, Pane: \$($GET_CURRNET_PANE_CMD)/\$($GET_TOTAL_PANES_CMD) ^l to cycle panes"
PREVIEW_COMMAND="tmux capture-pane -ep -t {}.\$($GET_CURRNET_PANE_CMD) | tail -n \${FZF_PREVIEW_LINES:-20}"
CYCLE_PANE_CMD="
        CURRENT_PANE=\$($GET_CURRNET_PANE_CMD); \
        TOTAL_PANES=\$($GET_TOTAL_PANES_CMD); \
        NEXT_PANE=\$(((CURRENT_PANE % TOTAL_PANES) + 1)); \
        echo \$NEXT_PANE > $TMP_PANE_FILE;
"

PREVIEW_BIND="ctrl-o:toggle-preview+transform-preview-label($LABEL_CMD)+change-preview($PREVIEW_COMMAND)+refresh-preview"
CYCLE_PANE_BIND="ctrl-l:execute-silent($CYCLE_PANE_CMD)+transform-preview-label($LABEL_CMD)+change-preview($PREVIEW_COMMAND)+refresh-preview"
FOCUS_CHANGED_BIND="focus:transform-preview-label($LABEL_CMD)+change-preview($PREVIEW_COMMAND)+refresh-preview"
kill_session_bind() {
        local reload_cmd
        reload_cmd="$1"
        echo "ctrl-d:execute-silent(tmux kill-session -t {})+reload-sync($reload_cmd)+down"
}
get_result_marked_sessions() {
        case $T_RUNTYPE in
        attached)
                if [[ -z $FZF_TMUX_OPTS ]]; then
                        FZF_TMUX_OPTS="-p 80%,80%"
                fi
                T_RUNTYPE_CMD="fzf-tmux $FZF_TMUX_OPTS"
                ;;
        detached)
                T_RUNTYPE_CMD="fzf"
                ;;
        serverless)
                T_RUNTYPE_CMD="fzf"
                ;;
        esac
        RESULT=$(
                (get_sessions_by_mru_with_idx) | $T_RUNTYPE_CMD \
                        --bind "$MOVE_DOWN_BIND" \
                        --bind "$MOVE_UP_BIND" \
                        --bind "$REMOVE_BIND" \
                        --bind "$FOCUS_CHANGED_BIND" \
                        --bind "$CYCLE_PANE_BIND" \
                        --bind "$PREVIEW_BIND" \
                        --bind "$(kill_session_bind "$get_sessions_by_mru_with_idx_cmd")" \
                        --preview-window="right:80%:hidden" \
                        --border-label "$MARKED_BORDER_LABEL" \
                        --header "$MARKED_SESSION_HEADER" \
                        --no-sort \
                        --prompt "$PROMPT"
        )
}
get_result() {
        local runtype_cmd
        runtype_cmd="$(get_fzf_results_cmd)"

        case $T_RUNTYPE in
        attached)
                if [[ -z $FZF_TMUX_OPTS ]]; then
                        FZF_TMUX_OPTS="-p 80%,80%"
                fi

                RESULT=$(
                        (eval "$runtype_cmd") | fzf-tmux \
                                --bind "$FIND_BIND" \
                                --bind "$SESSION_BIND" \
                                --bind "$TAB_BIND" \
                                --bind "$ZOXIDE_BIND" \
                                --bind "$FOCUS_CHANGED_BIND" \
                                --bind "$CYCLE_PANE_BIND" \
                                --bind "$PREVIEW_BIND" \
                                --bind "$(kill_session_bind "$runtype_cmd")" \
                                --preview-window="right:80%:hidden" \
                                --border-label "$BORDER_LABEL" \
                                --header "$HEADER" \
                                --no-sort \
                                --prompt "$PROMPT" \
                                "$FZF_TMUX_OPTS"
                )
                ;;
        detached)
                RESULT=$(
                        (eval "$runtype_cmd") | fzf \
                                --bind "$FIND_BIND" \
                                --bind "$SESSION_BIND" \
                                --bind "$TAB_BIND" \
                                --bind "$ZOXIDE_BIND" \
                                --bind "$FOCUS_CHANGED_BIND" \
                                --bind "$CYCLE_PANE_BIND" \
                                --bind "$PREVIEW_BIND" \
                                --bind "$(kill_session_bind "$runtype_cmd")" \
                                --preview-window="right:80%:hidden" \
                                --border \
                                --border-label "$BORDER_LABEL" \
                                --header "$HEADER" \
                                --no-sort \
                                --prompt "$PROMPT"
                )
                ;;
        serverless)
                RESULT=$(
                        (eval "$runtype_cmd") | fzf \
                                --bind "$FIND_BIND" \
                                --bind "$TAB_BIND" \
                                --bind "$ZOXIDE_BIND" \
                                --bind "$FOCUS_CHANGED_BIND" \
                                --bind "$CYCLE_PANE_BIND" \
                                --bind "$PREVIEW_BIND" \
                                --bind "$(kill_session_bind "$runtype_cmd")" \
                                --preview-window="right:80%:hidden" \
                                --border \
                                --border-label "$BORDER_LABEL" \
                                --header " ^x zoxide ^f find" \
                                --no-sort \
                                --prompt "$PROMPT"
                )
                ;;
        esac
}
display_message() {
        if [ "$T_RUNTYPE" == "attached" ]; then
                tmux display-message -t "$(get_current_session_id)" "$1"
        else
                echo "$1"
        fi
}

fzf_border_label_default=' t - smart tmux session manager '
BORDER_LABEL=${T_FZF_BORDER_LABEL:-$fzf_border_label_default}

HEADER=" ^s sessions ^x zoxide ^f find"
SESSION_BIND="ctrl-s:change-prompt(sessions> )+reload($get_sessions_by_mru_cmd)"
ZOXIDE_BIND="ctrl-x:change-prompt(zoxide> )+reload($get_zoxide_results_cmd)"
TAB_BIND="tab:down,btab:up"

if [ $# -ge 1 ]; then                  # argument provided
        if [[ "$1" = +([0-9]) ]]; then # numeric argument
                if [ "$1" -lt 1 ]; then
                        display_message "Numeric argument must be 1 or greater"
                        exit 1
                fi
                if [ "$1" -gt 9 ]; then
                        display_message "Numeric argument must be 9 or less"
                        exit 1
                fi
                SESSION_COUNT=$(get_sessions_by_mru_with_idx | wc -l)
                if [ "$1" -gt "$SESSION_COUNT" ]; then
                        display_message "There are only $SESSION_COUNT sessions"
                        exit 1
                fi
                RESULT=$(get_sessions_by_mru_with_idx | sed -n "${1}p")
        elif [ "$1" = "mark" ]; then
                if [ -z "$2" ]; then
                        display_message "Expected argument after mark: list, add or remove"
                        exit 1
                elif [ "$2" = "list" ]; then
                        get_result_marked_sessions
                elif [ "$2" = "remove" ]; then
                        if [ "$T_RUNTYPE" != "attached" ]; then
                                display_message "mark can only be used from inside an attached tmux session"
                                exit 1
                        fi
                        if [ -z "$(tmux display-message -p -F "#{SESSIONIZER_IDX}")" ]; then
                                display_message "Session is not marked"
                                exit 0
                        fi
                        tmux setenv -t "$(tmux display-message -p "#{session_id}")" SESSIONIZER_IDX ""
                        display_message "Removed index for session $(tmux display-message -p "#{session_name}")"
                        exit 0
                elif [ "$2" = "add" ]; then
                        if [ "$T_RUNTYPE" != "attached" ]; then
                                display_message "mark can only be used from inside an attached tmux session"
                                exit 1
                        fi
                        if [ ! -z "$(tmux display-message -p -F "#{SESSIONIZER_IDX}")" ]; then
                                display_message "Session is already marked"
                                exit 0
                        fi
                        SESSION_COUNT=$(get_sessions_by_mru_with_idx | wc -l)
                        if [ "$SESSION_COUNT" -gt 9 ]; then
                                display_message "mark can only be used when there are 9 or less sessions"
                                exit 1
                        fi
                        # set session env var SESSIONIZER_IDX to next free index
                        for i in $(seq 1 9); do
                                if ! tmux list-sessions -F '#{?#{==:#{SESSIONIZER_IDX},'"$i"'},"X",""}' | grep X &>/dev/null; then
                                        tmux setenv -t "$(tmux display-message -p "#{session_id}")" SESSIONIZER_IDX "$i"
                                        display_message "Set index $i for session $(tmux display-message -p "#{session_name}")"
                                        exit 0
                                fi
                        done
                else
                        display_message "Expected argument after mark: list, add or remove"
                        exit 1
                fi
        elif [ "$1" = "history" ]; then
                history_manager
                exit 0
        elif [ "$1" = "-r" ] || [ "$1" == "--repo" ]; then
                if [[ -z $T_REPOS_DIR ]]; then
                        display_message "T_REPOS_DIR has not been set"
                        exit 1
                fi

                if [ -z "$2" ]; then
                        display_message "No repository url provided -r {url}"
                        exit 1
                fi

                REPO_URL=$2
                cd $T_REPOS_DIR

                if git clone --recursive $REPO_URL; then
                        RESULT="$T_REPOS_DIR/$(basename "$_" .git)"
                else
                        exit $? # exit code from last command
                fi

        else # not -r or --repo
                zoxide query "$1" &>/dev/null
                ZOXIDE_RESULT_EXIT_CODE=$?
                if [ $ZOXIDE_RESULT_EXIT_CODE -eq 0 ]; then # zoxide result found
                        RESULT=$(zoxide query "$1")
                else # no zoxide result found
                        ls "$1" &>/dev/null
                        LS_EXIT_CODE=$?
                        if [ $LS_EXIT_CODE -eq 0 ]; then # directory found
                                RESULT=$1
                        else # no directory found
                                display_message "No directory found."
                                exit 1
                        fi
                fi
        fi
else # argument not provided
        get_result
fi

if [ "$RESULT" = "" ]; then # no result
        exit 0              # exit silently
fi

if [ $HOME_SED_SAFE -eq 0 ]; then
        RESULT=$(echo "$RESULT" | sed -e "s|^~/|$HOME/|") # get real home path back
fi

zoxide add "$RESULT" &>/dev/null # add to zoxide database

if [[ $RESULT != /* ]]; then # not folder path from zoxide result
        SESSION_NAME=$RESULT
elif [[ $T_SESSION_USE_GIT_ROOT == 'true' ]]; then
        GIT_ROOT=$(git -C $RESULT rev-parse --show-toplevel 2>/dev/null) && echo $GIT_ROOT >/dev/null
        if [[ $? -ne 0 ]]; then # not inside git repository
                SESSION_NAME=$(basename "$RESULT" | tr ' .:' '_')
        else # is in git repository
                BASENAME=$(basename $GIT_ROOT)
                RELATIVE_PATH=${RESULT#$GIT_ROOT}

                # git worktree
                GIT_WORKTREE_ROOT=$(git -C $RESULT rev-parse --git-common-dir 2>/dev/null) && echo $GIT_WORKTREE_ROOT >/dev/null
                if [[ $? -eq 0 ]] && [[ ! $GIT_WORKTREE_ROOT =~ ^(\.\./)*\.git$ ]]; then              # is inside git worktree
                        GIT_WORKTREE_ROOT=$(echo $GIT_WORKTREE_ROOT | sed -E 's/(\/.git|\/.bare)$//') # remove .git or .bare suffix
                        BASENAME=$(basename $GIT_WORKTREE_ROOT)
                        RELATIVE_PATH=${RESULT#$GIT_WORKTREE_ROOT}
                fi

                SEPARATOR="/"
                FORMATTED_PATH="${RELATIVE_PATH//\//$SEPARATOR}"
                SESSION_NAME=$(echo $BASENAME$FORMATTED_PATH | tr ' .:' '_')
        fi
elif [[ $T_SESSION_NAME_INCLUDE_PARENT == 'true' ]]; then
        SESSION_NAME=$(echo "$RESULT" | tr ' .:' '_' | awk -F "/" '{print $(NF-1)"/"$NF}')
else
        SESSION_NAME=$(basename "$RESULT" | tr ' .:' '_')
fi

if [ "$T_RUNTYPE" != "serverless" ]; then
        SESSION=$(tmux list-sessions -F '#S' | grep "^$SESSION_NAME$") # find existing session
fi

if [ "$SESSION" = "" ]; then # session is missing
        SESSION="$SESSION_NAME"
        if [ -e $RESULT/.t ]; then
                tmux new-session -d -s "$SESSION" -c "$RESULT" $RESULT/.t # create session and run .t startup script
        else
                tmux new-session -d -s "$SESSION" -c "$RESULT" # create session
        fi
fi

case $T_RUNTYPE in # attach to session
attached)
        tmux switch-client -t "$SESSION"
        ;;
detached | serverless)
        tmux attach -t "$SESSION"
        ;;
esac
